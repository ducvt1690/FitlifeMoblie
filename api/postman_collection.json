{
  "info": {
    "name": "FitLife Pro RESTful API Collection",
    "description": "Bộ sưu tập kiểm thử toàn bộ RESTful API cho dự án FitLife Pro (projectMMA)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth API",
      "item": [
        {
          "name": "Đăng ký tài khoản (POST /api/auth/register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn A\",\n  \"email\": \"nguyenvana@gmail.com\",\n  \"password\": \"MatKhau123!\"\n}"
            }
          }
        },
        {
          "name": "Đăng nhập (POST /api/auth/login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@gmail.com\",\n  \"password\": \"MatKhau123!\"\n}"
            }
          }
        },
        {
          "name": "Đặt lại mật khẩu (POST /api/auth/reset-password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@gmail.com\",\n  \"newPassword\": \"MatKhauMoi456!\"\n}"
            }
          }
        },
        {
          "name": "Danh sách người dùng (GET /api/auth/users)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/auth/users"
          }
        }
      ]
    },
    {
      "name": "2. Health & Workout API",
      "item": [
        {
          "name": "Tổng quan chỉ số ngày (GET /api/health/summary)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/health/summary"
          }
        },
        {
          "name": "Ghi nhận nước uống (POST /api/health/water)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/health/water",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"1\",\n  \"amount\": 250\n}"
            }
          }
        },
        {
          "name": "Ghi nhận buổi tập (POST /api/health/workout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/health/workout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"1\",\n  \"title\": \"Đẩy ngực với tạ đòn\",\n  \"calories\": 180,\n  \"duration\": 900\n}"
            }
          }
        },
        {
          "name": "Danh sách bài tập ExerciseDB (GET /api/health/exercises)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/health/exercises?limit=25"
          }
        }
      ]
    },
    {
      "name": "3. AI Coach API",
      "item": [
        {
          "name": "Hỏi đáp Trợ lý AI (POST /api/ai/chat)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/ai/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"1 tô phở bò bao nhiêu calo?\",\n  \"profile\": { \"weight\": 65, \"height\": 170 }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Shop API",
      "item": [
        {
          "name": "Danh sách vật phẩm (GET /api/shop/items)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/shop/items"
          }
        },
        {
          "name": "Đổi vật phẩm bằng FitCoins (POST /api/shop/buy)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:5000/api/shop/buy",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"1\",\n  \"itemId\": \"badge_2\"\n}"
            }
          }
        }
      ]
    }
  ]
}
