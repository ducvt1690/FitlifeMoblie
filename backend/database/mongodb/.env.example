# Copy this file to .env in THIS directory. Never commit the real connection string.
MONGODB_URI=mongodb+srv://fitlife_admin:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/?retryWrites=true&w=majority
MONGODB_DB_NAME=fitlife

# Optional: required only for npm run db:seed:demo (at least 12 characters).
# The seeded email is demo@fitlife.example. Only a salted scrypt hash is stored.
FITLIFE_DEMO_PASSWORD=
