{
  "name": "fitlife-mongodb-database",
  "version": "2.1.0",
  "private": true,
  "description": "MongoDB Atlas schema, indexes and seed data for FitLife; independent of the API",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "db:init": "node scripts/cli.js init",
    "db:seed": "node scripts/cli.js seed",
    "db:seed:demo": "node scripts/cli.js demo",
    "db:seed:samples": "node scripts/fill-samples.js",
    "db:verify": "node scripts/cli.js verify",
    "db:migrate:plan": "node scripts/cli.js migrate-plan",
    "db:migrate": "node scripts/cli.js migrate",
    "db:profile:plan": "node scripts/profile-birth-date.js",
    "db:profile:apply": "node scripts/profile-birth-date.js --apply",
    "db:exercises:import": "node scripts/import-exercisedb-v1.js",
    "db:language:vi": "node scripts/localize-vietnamese.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:simplify:plan": "node scripts/cli.js simplify-plan",
    "db:simplify": "node scripts/cli.js simplify"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
