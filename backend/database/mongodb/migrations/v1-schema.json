[
  {
    "name": "users",
    "id": "user_id",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "title": "FitLife users",
        "additionalProperties": false,
        "required": [
          "user_id",
          "created_at",
          "updated_at",
          "email",
          "password_hash",
          "full_name",
          "gender",
          "age",
          "height",
          "weight",
          "activity_level",
          "goal",
          "target_water",
          "target_calories",
          "fit_coins",
          "streak_days",
          "timezone"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "user_id": {
            "bsonType": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          },
          "email": {
            "bsonType": "string",
            "minLength": 3,
            "maxLength": 100,
            "pattern": "^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,}$"
          },
          "password_hash": {
            "bsonType": "string",
            "minLength": 40,
            "maxLength": 1024,
            "pattern": "^(scrypt\\$|\\$2[aby]\\$|\\$argon2(id|i|d)\\$)"
          },
          "full_name": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "gender": {
            "bsonType": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "age": {
            "bsonType": "int",
            "minimum": 5,
            "maximum": 100
          },
          "height": {
            "bsonType": [
              "int",
              "long",
              "double",
              "decimal"
            ],
            "minimum": 80,
            "maximum": 250
          },
          "weight": {
            "bsonType": [
              "int",
              "long",
              "double",
              "decimal"
            ],
            "minimum": 25,
            "maximum": 300
          },
          "activity_level": {
            "bsonType": "string",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "active"
            ]
          },
          "goal": {
            "bsonType": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ]
          },
          "target_water": {
            "bsonType": "int",
            "minimum": 500
          },
          "target_calories": {
            "bsonType": "int",
            "minimum": 800
          },
          "fit_coins": {
            "bsonType": "int",
            "minimum": 0
          },
          "streak_days": {
            "bsonType": "int",
            "minimum": 0
          },
          "timezone": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)*$"
          },
          "streak_last_date": {
            "bsonType": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error",
    "indexes": [
      {
        "key": {
          "user_id": 1
        },
        "name": "uq_user_id",
        "unique": true
      },
      {
        "key": {
          "email": 1
        },
        "name": "uq_user_email",
        "unique": true
      }
    ]
  },
