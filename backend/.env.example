PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<DATABASE_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_HOST>/?retryWrites=true&w=majority
MONGODB_DB_NAME=fitlife
AUTH_SESSION_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173
# Optional AI Coach. Leave empty to use the built-in rule-based coach.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# AI plans: Gemini primary, optional Groq backup. Keys stay on the backend only.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# VNPay sandbox (https://sandbox.vnpayment.vn/devreg). Leave empty to disable payments.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public URL of this API (VNPay return/IPN) and of the website.
PUBLIC_API_URL=http://localhost:5000
WEB_APP_URL=http://localhost:5173
# Set to 1 behind a trusted proxy such as Vercel so rate limits see the client IP.
TRUST_PROXY=
