{
  "info": {
    "name": "FitLife — Gmail verification then registration (manual)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the local FitLife Registration environment. Send 01, read the OTP from your Gmail inbox, set registrationCode, then send 02 and 03. Do not Run all: email delivery and manual OTP entry separate steps 01 and 02. Passwords, codes and tokens stay in your local environment. SMTP must be configured on the backend. Existing accounts should use login."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 — Send email verification code",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register/email-code",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.environment.get('registrationEmail')) throw new Error('Set registrationEmail in the local registration environment.');",
              "pm.environment.unset('registrationCode'); pm.environment.unset('verificationToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('OTP is not exposed by the API',()=>{pm.expect(pm.response.json()).not.to.have.property('code');});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Verify code from Gmail",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register/verify-email",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"code\": \"{{registrationCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!/^\\d{6}$/.test(pm.environment.get('registrationCode')||'')) throw new Error('Read Gmail and set registrationCode to the six-digit OTP first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.environment.set('verificationToken',pm.response.json().verification_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Register with verified email",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"verification_token\": \"{{verificationToken}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"confirm_password\": \"{{registrationPasswordConfirmation}}\",\n  \"full_name\": \"Nguyễn Văn An\",\n  \"gender\": \"male\",\n  \"age\": 23,\n  \"height\": 170,\n  \"weight\": 65,\n  \"activity_level\": \"moderate\",\n  \"goal\": \"maintain\",\n  \"timezone\": \"Asia/Ho_Chi_Minh\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.environment.get('verificationToken')) throw new Error('Verify email with request 02 first.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if(pm.response.code===201){pm.environment.set('sessionToken',pm.response.json().token);pm.environment.unset('verificationToken');pm.environment.unset('registrationCode');}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.environment.set('sessionToken',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Current account",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sessionToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Logout current session",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sessionToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "if(pm.response.code===204)pm.environment.unset('sessionToken');"
            ]
          }
        }
      ]
    }
  ]
}
