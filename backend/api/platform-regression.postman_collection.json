        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{testPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login admin status\",()=>pm.expect([200]).to.include(pm.response.code));",
              "if(pm.response.code===200){const b=pm.response.json();pm.collectionVariables.set('adminToken',b.token);pm.collectionVariables.set('adminId',b.user.user_id);}"
            ]
          }
        }
