users chứa cả ba role user / trainer / admin. trainer_links.user_id = null khi lời mời chưa được chấp nhận (phía users: 0..1).
exercises hiện độc lập: workout_logs và workout_templates chưa lưu exercise_id. admin_logs.target_id là tham chiếu đa hình theo target_type." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#50667B;strokeColor=none;fillColor=none;" vertex="1" parent="1" ><mxGeometry x="70" y="1530.5" width="899" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="coaching" name="04 — Trainer, admin &amp; chat"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1548" pageHeight="1877" math="0" shadow="0" background="#F5F7FB"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="TRAINER, ADMIN &amp; AI CHAT" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=29;fontStyle=1;fontColor=#173449;strokeColor=none;fillColor=none;" vertex="1" parent="1" ><mxGeometry x="70" y="35" width="1408" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="7 collections · Đầy đủ trường trong validator, ẩn _id · Schema hiện tại, 03/11/2026" style="text;html=0;align=left;fontFamily=Arial;fontSize=15;fontColor=#50667B;strokeColor=none;fillColor=none;" vertex="1" parent="1" ><mxGeometry x="70" y="90" width="1408" height="28" as="geometry"/></mxCell><mxCell id="legend" value="PK = khóa nghiệp vụ unique   •   FK = tham chiếu logic   •   UK = unique   •   ? = optional hoặc nullable   •   1 → 0..N = một–nhiều" style="text;html=0;align=left;fontFamily=Arial;fontSize=12;fontColor=#50667B;strokeColor=none;fillColor=none;" vertex="1" parent="1" ><mxGeometry x="70" y="125" width="1408" height="28" as="geometry"/></mxCell><mxCell id="rel-0" value="user_id" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.3;strokeColor=#6244A0;fontFamily=Arial;fontSize=11;fontColor=#365268;labelBackgroundColor=#F5F7FB;startArrow=ERone;endArrow=ERzeroToMany;startSize=14;endSize=16;exitX=1;exitY=0.5